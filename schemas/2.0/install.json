{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flix-wg.github.io/crosstalk/schema/v2/install.json",
  "x-crosstalk-version": "2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "epoch",
    "lease_id",
    "env",
    "fence",
    "max_fence",
    "dry_run"
  ],
  "properties": {
    "epoch": {
      "type": "string",
      "format": "uuid"
    },
    "lease_id": {
      "type": "string",
      "format": "uuid"
    },
    "env": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "fence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max_fence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dry_run": {
      "type": "boolean"
    }
  }
}
