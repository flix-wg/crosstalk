{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flix-wg.github.io/crosstalk/schema/v2/board.json",
  "x-crosstalk-version": "2.0",
  "type": "object",
  "properties": {
    "epoch": {
      "type": "string",
      "format": "uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "result": {
      "type": "object",
      "properties": {
        "frozen": {
          "type": "boolean"
        },
        "coordination": {
          "type": "object",
          "properties": {
            "branches": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/branch_status"
              }
            },
            "policy": {
              "type": "object",
              "properties": {
                "sequences": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[a-z0-9][a-z0-9_-]*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[^()]*\\(\\\\d\\+\\)[^()]*$"
                  }
                },
                "protected_branches": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                },
                "gates": {
                  "type": "object",
                  "properties": {
                    "merge": {
                      "type": "object",
                      "properties": {
                        "unknown": {
                          "enum": [
                            "pass",
                            "warn",
                            "block"
                          ]
                        },
                        "unknown_source": {
                          "enum": [
                            "pass",
                            "warn",
                            "block"
                          ]
                        },
                        "stale_ready": {
                          "enum": [
                            "pass",
                            "warn",
                            "block"
                          ]
                        }
                      },
                      "required": []
                    }
                  },
                  "required": []
                },
                "envs": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "require_on": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": []
                  }
                }
              },
              "required": []
            }
          },
          "required": [
            "branches",
            "policy"
          ]
        },
        "presence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "session": {
                "type": "string",
                "format": "uuid"
              },
              "principal": {
                "type": "string",
                "pattern": "^(human|ci):[a-z0-9][a-z0-9-]{0,38}$"
              },
              "tool": {
                "type": "string"
              },
              "device": {
                "type": "string"
              },
              "doing": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "working",
                  "waiting",
                  "offline"
                ]
              },
              "expires_at": {
                "type": "integer"
              }
            },
            "required": [
              "session",
              "principal",
              "tool",
              "device",
              "doing",
              "state",
              "expires_at"
            ]
          }
        },
        "leases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "exclusive",
                  "shared"
                ]
              },
              "lease_id": {
                "type": "string",
                "format": "uuid"
              },
              "holder": {
                "type": "string",
                "format": "uuid"
              },
              "resources": {
                "$ref": "#/$defs/keys"
              },
              "state": {
                "enum": [
                  "pending",
                  "held",
                  "released",
                  "expired",
                  "revoked"
                ]
              },
              "fence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "rev": {
                "type": "integer",
                "minimum": 1
              },
              "note": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 280
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "supersedes": {
                "anyOf": [
                  {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uuid"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "minItems": 2,
                    "uniqueItems": true
                  }
                ]
              },
              "expires_at": {
                "$ref": "#/$defs/time"
              },
              "expires_in_s": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "mode",
              "lease_id",
              "holder",
              "resources",
              "state",
              "fence",
              "rev",
              "note",
              "supersedes",
              "expires_at",
              "expires_in_s"
            ]
          }
        },
        "asks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ask"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "reservations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "string"
              },
              "value": {
                "type": "integer",
                "minimum": 0
              },
              "holder": {
                "type": "string",
                "format": "uuid"
              },
              "abandoned": {
                "enum": [
                  0,
                  1
                ]
              }
            },
            "required": [
              "sequence",
              "value",
              "holder",
              "abandoned"
            ]
          }
        },
        "more": {
          "type": "object",
          "properties": {
            "presence": {
              "type": "boolean"
            },
            "leases": {
              "type": "boolean"
            },
            "asks": {
              "type": "boolean"
            },
            "messages": {
              "type": "boolean"
            },
            "decisions": {
              "type": "boolean"
            },
            "deployments": {
              "type": "boolean"
            },
            "reservations": {
              "type": "boolean"
            }
          },
          "required": [
            "presence",
            "leases",
            "asks",
            "messages",
            "decisions",
            "deployments",
            "reservations"
          ]
        },
        "deployments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deployment"
          }
        },
        "live": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "live_artifact": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/digest"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "live_sha": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/oid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "exec_seq": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "live_artifact",
              "live_sha",
              "exec_seq"
            ]
          }
        },
        "audit": {
          "type": "object",
          "properties": {
            "head": {
              "$ref": "#/$defs/hash"
            },
            "exported_seq": {
              "type": "integer",
              "minimum": 0
            },
            "lag": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "head",
            "exported_seq",
            "lag"
          ]
        }
      },
      "required": [
        "frozen",
        "coordination",
        "presence",
        "leases",
        "asks",
        "messages",
        "decisions",
        "reservations",
        "more"
      ]
    }
  },
  "required": [
    "epoch",
    "seq",
    "result"
  ],
  "$defs": {
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "oid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "key": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(path:[^/].*[^/]|path:[^/]|tree:[^/].*/|branch:\\S+|env:[a-z0-9][a-z0-9-]*|res:\\S+|seq:[a-z0-9][a-z0-9_-]*)$"
    },
    "keys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/key"
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "text"
            ],
            "properties": {
              "kind": {
                "const": "text"
              },
              "text": {
                "$ref": "#/$defs/text"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "data"
            ],
            "properties": {
              "kind": {
                "const": "data"
              },
              "data": {
                "type": "object"
              }
            }
          }
        ]
      }
    },
    "branch_status": {
      "type": "object",
      "required": [
        "type",
        "branch",
        "state",
        "head",
        "owner",
        "rev"
      ],
      "properties": {
        "type": {
          "const": "branch_status"
        },
        "branch": {
          "type": "string"
        },
        "state": {
          "enum": [
            "wip",
            "draft",
            "ready"
          ]
        },
        "head": {
          "$ref": "#/$defs/oid"
        },
        "owner": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "maxLength": 280
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 140
          },
          "maxItems": 10
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "lease": {
      "type": "object",
      "required": [
        "type",
        "lease_id",
        "op",
        "state",
        "resources",
        "holder",
        "fence",
        "rev",
        "expires_at"
      ],
      "properties": {
        "type": {
          "const": "lease"
        },
        "mode": {
          "enum": [
            "exclusive",
            "shared"
          ]
        },
        "lease_id": {
          "type": "string",
          "format": "uuid"
        },
        "op": {
          "enum": [
            "acquire",
            "install",
            "release",
            "expire",
            "revoke"
          ]
        },
        "state": {
          "enum": [
            "pending",
            "held",
            "released",
            "expired",
            "revoked"
          ]
        },
        "resources": {
          "$ref": "#/$defs/keys"
        },
        "holder": {
          "type": "string",
          "format": "uuid"
        },
        "fence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string",
          "maxLength": 280
        },
        "supersedes": {
          "anyOf": [
            {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "expires_at": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "reservation": {
      "type": "object",
      "required": [
        "type",
        "sequence",
        "value",
        "holder"
      ],
      "properties": {
        "type": {
          "const": "reservation"
        },
        "sequence": {
          "type": "string"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "holder": {
          "type": "string"
        },
        "note": {
          "type": "string",
          "maxLength": 280
        }
      }
    },
    "message": {
      "type": "object",
      "required": [
        "type",
        "message_id",
        "to",
        "context_id",
        "parts"
      ],
      "properties": {
        "type": {
          "const": "message"
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "to": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(human:[a-z0-9-]+|ci:[a-z0-9-]+|session:[0-9a-f-]{36}|all)$"
          }
        },
        "context_id": {
          "type": "string",
          "format": "uuid"
        },
        "parts": {
          "$ref": "#/$defs/parts"
        }
      }
    },
    "ask": {
      "type": "object",
      "required": [
        "type",
        "ask_id",
        "rev",
        "kind",
        "to",
        "question",
        "state"
      ],
      "properties": {
        "type": {
          "const": "ask"
        },
        "ask_id": {
          "type": "string",
          "format": "uuid"
        },
        "rev": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "question",
            "approval"
          ]
        },
        "to": {
          "type": "string",
          "pattern": "^human:[a-z0-9][a-z0-9-]{0,38}$"
        },
        "question": {
          "$ref": "#/$defs/text"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "maxItems": 16
        },
        "blocks": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^(merge:(branch|target):\\S+|deploy:env:[a-z0-9-]+)$"
          }
        },
        "bound_head": {
          "$ref": "#/$defs/oid"
        },
        "bound_artifact": {
          "$ref": "#/$defs/digest"
        },
        "state": {
          "enum": [
            "open",
            "answered",
            "withdrawn"
          ]
        },
        "deadline": {
          "$ref": "#/$defs/time"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "question"
          }
        }
      },
      "then": {
        "properties": {
          "blocks": {
            "maxItems": 0
          }
        }
      }
    },
    "answer": {
      "type": "object",
      "required": [
        "type",
        "ask_id",
        "answer_id"
      ],
      "properties": {
        "type": {
          "const": "answer"
        },
        "ask_id": {
          "type": "string",
          "format": "uuid"
        },
        "answer_id": {
          "type": "string",
          "format": "uuid"
        },
        "choice": {
          "type": "string",
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "type",
        "decision_id",
        "source",
        "verdict",
        "bound_head",
        "decided_by"
      ],
      "properties": {
        "type": {
          "const": "decision"
        },
        "decision_id": {
          "type": "string",
          "format": "uuid"
        },
        "source": {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "ask",
                "override"
              ]
            },
            "id": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "verdict": {
          "enum": [
            "approve",
            "reject"
          ]
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "bound_head": {
          "$ref": "#/$defs/oid"
        },
        "bound_artifact": {
          "$ref": "#/$defs/digest"
        },
        "rationale": {
          "type": "string",
          "maxLength": 4096
        },
        "decided_by": {
          "type": "string",
          "pattern": "^human:[a-z0-9-]+$"
        }
      }
    },
    "deployment": {
      "type": "object",
      "required": [
        "type",
        "env",
        "sha",
        "artifact",
        "op",
        "exec_seq",
        "outcome",
        "live_after"
      ],
      "properties": {
        "type": {
          "const": "deployment"
        },
        "env": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "sha": {
          "$ref": "#/$defs/oid"
        },
        "artifact": {
          "$ref": "#/$defs/digest"
        },
        "fence": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "op": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "exec_seq": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "live_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "promoted",
            "failed",
            "reconciled",
            "adopted"
          ]
        }
      }
    },
    "admin": {
      "type": "object",
      "required": [
        "type",
        "action"
      ],
      "properties": {
        "type": {
          "const": "admin"
        },
        "action": {
          "enum": [
            "principal_enrolled",
            "principal_revoked",
            "epoch_started",
            "gates_frozen",
            "gates_unfrozen",
            "requirement_withdrawn",
            "override_recorded",
            "executor_enrolled",
            "lease_installed",
            "policy_set",
            "ref_seeded"
          ]
        },
        "subject": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "maxLength": 280
        }
      }
    }
  }
}
